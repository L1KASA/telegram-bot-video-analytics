TELEGRAM_BOT_TOKEN=tg_token
POSTGRES_HOST=host
POSTGRES_DB=db
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password

APPLICATION_NAME=video-analytics-bot

LLM_MODEL=deepseek-r1:8b
